
# Ensure required variables are set in the U-Boot environment:
FB: ucmd test -n "${fastboot_partition_alias_all}"
FB: ucmd test -n "${fastboot_partition_alias_bootloader}${fastboot_raw_partition_bootloader}"
FB: ucmd test -n "${fastboot_default_buf_addr}"
FB: ucmd test -n "${fastboot_default_buf_size}"
FB: ucmd test -n "${emmc_dev}"
FB: ucmd test -n "${emmc_ack}"

# Flash WIC  image (containing the OS):
FB: ucmd echo "=="; echo "== Flashing WIC image..."; echo "=="
FB[-t 300000]: flash -raw2sparse all ../wic-image.lnk

# Flash U-Boot:
FB: ucmd echo "=="; echo "== Flashing bootloader..."; echo "=="
FB[-t 30000]: flash -scanterm -scanlimited 0x800000 bootloader ../bootloader.lnk

FB: ucmd echo "=="; echo "== Running mmc partconf ${emmc_dev} ${emmc_ack} 1 0"; echo "=="
FB: ucmd mmc partconf "${emmc_dev}" "${emmc_ack}" 1 0

FB: done
